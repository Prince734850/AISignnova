<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_futuristic"
    android:fillViewport="true"
    tools:context=".CameraActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- TOP BAR HEADER -->
        <LinearLayout
            android:id="@+id/topBarCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_tab_container"
                android:contentDescription="Back"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/text_white" />

            <TextView
                android:id="@+id/tvLiveTranslatorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/live_translator"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_tab_container"
                android:contentDescription="More Options"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more"
                app:tint="@color/text_white" />
        </LinearLayout>

        <!-- CAMERA PREVIEW CARD & OVERLAYS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cameraCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="4:4.8"
            app:layout_constraintTop_toBottomOf="@id/topBarCamera">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/camera_preview_bg">

                <!-- REAL CAMERA PREVIEW -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- TOP-LEFT: CAMERA ACTIVE PILL BADGE -->
                <TextView
                    android:id="@+id/tvCameraStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_tab_container"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🟢 Camera Active"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- CENTER: CYAN NEON SCANNING FRAME -->
                <ImageView
                    android:id="@+id/imgScanFrame"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:contentDescription="Hand Area Frame"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_scan_frame"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- RIGHT-SIDE OVERLAY CONTROLS (FLASH, CAMERA SWITCH, GALLERY) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnFlash"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_tab_container"
                        android:contentDescription="Flashlight"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_flash_off"
                        app:tint="@color/accent_cyan" />

                    <ImageButton
                        android:id="@+id/btnSwitchCamera"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_tab_container"
                        android:contentDescription="Switch Camera"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_switch_camera"
                        app:tint="@color/accent_cyan" />

                    <ImageButton
                        android:id="@+id/btnGallery"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_tab_container"
                        android:contentDescription="Gallery"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_gallery"
                        app:tint="@color/accent_cyan" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- GLASS DETECTION RESULT PANEL -->
        <LinearLayout
            android:id="@+id/outputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cameraCard">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvDetectedSignHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Detected Sign      🟢 Live"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- MANUAL SPEAKER BUTTON -->
                <ImageButton
                    android:id="@+id/btnSpeakNow"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_tab_container"
                    android:contentDescription="Speak Now"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="@color/accent_cyan" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvLiveGesture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- GESTURE TEXT OUTPUT -->
            <TextView
                android:id="@+id/tvTextOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/waiting_for_signs"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- CONFIDENCE PROGRESS INDICATOR -->
            <LinearLayout
                android:id="@+id/confidenceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvConfidenceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confidence: 0%"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressBarConfidence"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_tab_selected" />
            </LinearLayout>

        </LinearLayout>

        <!-- BOTTOM CONTROLS (CLEAR, PAUSE/RESUME, VOICE ON/OFF) -->
        <LinearLayout
            android:id="@+id/controlsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/outputCard">

            <!-- LEFT: CLEAR BUTTON -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnClearOutput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/btn_outline_cyan"
                android:text="🗑 Clear"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- CENTER: PAUSE / RESUME PROMINENT BUTTON -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPauseResume"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_gradient"
                android:text="⏸ Pause"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- RIGHT: VOICE ON / VOICE OFF BUTTON -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVoiceToggle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_container"
                android:text="🔊 Voice On"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
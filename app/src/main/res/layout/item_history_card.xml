<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_futuristic"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Gesture Icon Badge -->
    <androidx.cardview.widget.CardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="@color/input_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgHistoryGesture"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:contentDescription="Gesture Icon"
                android:src="@drawable/ic_sign_language"
                app:tint="@color/accent_cyan" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Namaste"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="04 Oct 2026 • 09:32 AM"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Play Audio Button -->
    <ImageButton
        android:id="@+id/btnHistoryPlayAudio"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_tab_container"
        android:contentDescription="Play Audio"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        app:tint="@color/accent_cyan" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <!-- MAIN SCREEN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_futuristic">

        <!-- TOP BAR -->
        <LinearLayout
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/card_profile"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                app:tint="@color/accent_cyan" />

            <TextView
                android:id="@+id/appTitleHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:letterSpacing="0.03"
                android:text="@string/signnova_header"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnNotification"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/card_settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notification"
                app:tint="@color/accent_cyan" />

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/card_profile"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_person"
                app:tint="@color/accent_cyan" />
        </LinearLayout>

        <!-- CONTENT CONTAINER (ScrollView) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/homeHeader"
            app:layout_constraintBottom_toTopOf="@id/bottomNavIconsRow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <!-- CENTER HERO SECTION -->
                <LinearLayout
                    android:id="@+id/heroSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_to"
                        android:textColor="@color/accent_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_central_title"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/home_subtitle"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp" />

                    <!-- AISIGNNOVA LOGO WITH TRANSPARENT BACKGROUND - NO CIRCLE, NO CARD, NO FRAME -->
                    <ImageView
                        android:id="@+id/homeSignNovaLogo"
                        android:layout_width="190dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="20dp"
                        android:contentDescription="@string/logo_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/signnova_logo" />

                </LinearLayout>

                <!-- MAIN ACTION BUTTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStartTranslating"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_button_gradient"
                    android:drawableStart="@drawable/ic_camera"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/btn_start_translating"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- FOUR BORDERLESS BOTTOM NAVIGATION ICONS -->
        <LinearLayout
            android:id="@+id/bottomNavIconsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- 1. PROFILE -->
            <LinearLayout
                android:id="@+id/cardProfile"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/card_profile"
                    android:src="@drawable/ic_person"
                    app:tint="@color/accent_cyan" />
            </LinearLayout>

            <!-- 2. NAMASTE / FOLDED HANDS -->
            <LinearLayout
                android:id="@+id/cardLearn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/card_learn"
                    android:src="@drawable/ic_learn_signs"
                    app:tint="@color/accent_cyan" />
            </LinearLayout>

            <!-- 3. HISTORY -->
            <LinearLayout
                android:id="@+id/cardHistory"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/card_history"
                    android:src="@drawable/ic_history"
                    app:tint="@color/accent_cyan" />
            </LinearLayout>

            <!-- 4. SETTINGS -->
            <LinearLayout
                android:id="@+id/cardSettings"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/card_settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/accent_cyan" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NAVIGATION DRAWER SIDE MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_dark"
        app:headerLayout="@layout/nav_header_main"
        app:itemIconTint="@color/accent_cyan"
        app:itemTextColor="@color/text_white" />

</androidx.drawerlayout.widget.DrawerLayout>
